# Copy to `.env` for local development and fill in real values.
# NEVER commit the real `.env` file to Git.

# --- Local development (default when unset) ---
APP_ENV=development
DATABASE_URL=sqlite:///./dev.db

# --- Production on VPS (Docker network `traffic_net`) ---
# Set APP_ENV=production. In production the app refuses to start unless
# DATABASE_URL is PostgreSQL and API_KEY is set (fail-fast guard).
# Use the PostgreSQL password set when the `traffic-db` stack was created.
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://trafficapp:<DB_PASSWORD>@traffic-postgres:5432/trafficdb

# Shared secret required in the X-API-Key header for write endpoints.
# Generate a long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY=<LONG_RANDOM_SECRET>
